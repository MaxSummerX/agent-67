API_KEY=your-key-here
BASE_URL=https://openrouter.ai/api/v1/chat/completions
MODEL=inclusionai/ling-3.0-flash-sante:free


# LLM Провайдер: openrouter, ollama, gigachat
PROVIDER=open_router


# --- Ollama (локальные модели) ---
# Для использования Ollama установите PROVIDER=ollama
OLLAMA_MODEL=ornith:latest
OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions


# --- GigaChat (Sber AI) ---
# Для использования GigaChat установите PROVIDER=gigachat
GIGACHAT_CREDENTIALS=your-CREDENTIALS-key-here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Lightning
# Получить credentials: https://developers.sber.ru/studio/
# Модели: GigaChat-2-Max, GigaChat-2-Pro, GigaChat-2-Lite
